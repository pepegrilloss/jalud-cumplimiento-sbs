APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=127.0.0.1,::1
MLP_ACTIVE_PROFILE_STATES=
MLP_RATE_LIMIT_LIVEWIRE=120
MLP_RATE_LIMIT_UPLOADS=20
MLP_RATE_LIMIT_FORMS=30
MLP_RATE_LIMIT_DOCUMENTS=60
MLP_RATE_LIMIT_LABELS=30
MLP_MASK_PII_TABLES=true
LABELARY_ENABLED=true
LABELARY_BASE_URL=https://api.labelary.com
LABELARY_TIMEOUT=8
DNI_OCR_ENABLED=false
TESSERACT_PATH=tesseract
TESSERACT_LANGUAGE=spa
TESSERACT_TIMEOUT=20
TESSERACT_PASS_TIMEOUT=8
TESSERACT_DPI=300
TESSDATA_PREFIX=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_WHATSAPP_TEMPLATE=nueva_solicitud_visita
META_WHATSAPP_TEMPLATE_NEXT_APPROVAL=siguiente_area_aprobacion
META_WHATSAPP_TEMPLATE_APPROVAL_REMINDER=recordatorio_aprobacion_3h
META_WHATSAPP_LANGUAGE=es_PE
META_WHATSAPP_TIMEOUT=10
ADMIN_WHATSAPP=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_ENCRYPT=yes
# Mantener true hasta confirmar certificado SQL Server valido y confiable.
# DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
