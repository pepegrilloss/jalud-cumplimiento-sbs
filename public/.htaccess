<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Bloquear archivos sensibles si el DocumentRoot se configura incorrectamente.
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:node_modules|bootstrap|config|database|resources|tests)(?:/|$) - [F,L]
    RewriteRule \.(?:env|sql|bak|backup|old|orig|save|swp|tmp|temp|log|ini|phar|zip|7z|rar|tar|gz)$ - [F,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Bloquear acceso directo a documentos sensibles si se crea un enlace /storage.
    # Las URLs temporales firmadas generadas por Laravel/Filament siguen pasando
    # por index.php para que Laravel valide la firma y expiracion.
    RewriteCond %{QUERY_STRING} (^|&)signature=
    RewriteRule ^storage/visitas/ index.php [L]
    RewriteCond %{QUERY_STRING} !(^|&)signature=
    RewriteRule ^storage/visitas/ - [F,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
